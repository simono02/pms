# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/project_management_db
SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost/project_management_db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=pdf

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Payment Gateway Configuration
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
PAYMENT_PUBLIC_KEY=your-public-key
PAYMENT_PRIVATE_KEY=your-private-key

# Security Configuration
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days
BCRYPT_LOG_ROUNDS=12

# Application Configuration
DEBUG=True
TESTING=False
